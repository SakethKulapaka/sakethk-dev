---
interface Props {
	pages: string[];
	title: string;
	/** page aspect ratio, width / height */
	aspectRatio?: number;
}

const { pages, title, aspectRatio = 1506 / 2107.5 } = Astro.props;
const width = 600;
const height = Math.round(width / aspectRatio);
const minWidth = 130;
const minHeight = Math.round(minWidth / aspectRatio);
---

<div
	class="flipbook-wrap"
	data-width={width}
	data-height={height}
	data-min-width={minWidth}
	data-min-height={minHeight}
>
	<div id="flipbook" aria-label={`${title} — flip through pages`}>
		{
			pages.map((src, i) => (
				<div class="page" data-density={i === 0 ? 'hard' : undefined}>
					<img
						src={src}
						alt={`${title}, page ${i + 1}`}
						width={width}
						height={height}
						loading={i < 2 ? 'eager' : 'lazy'}
					/>
				</div>
			))
		}
	</div>

	<div class="controls">
		<button id="prev" type="button" aria-label="Previous page">‹</button>
		<span id="page-indicator" aria-live="polite"></span>
		<button id="next" type="button" aria-label="Next page">›</button>
	</div>
</div>

<script>
	import { PageFlip } from 'page-flip';
	import 'page-flip/src/Style/stPageFlip.css';

	const wrap = document.querySelector<HTMLElement>('.flipbook-wrap');
	const el = document.getElementById('flipbook');
	if (wrap && el) {
		const width = Number(wrap.dataset.width);
		const height = Number(wrap.dataset.height);
		const minWidth = Number(wrap.dataset.minWidth);
		const minHeight = Number(wrap.dataset.minHeight);
		const pageElements = el.querySelectorAll<HTMLElement>('.page');

		// HTML mode renders real <img> elements instead of a canvas, so pages
		// stay crisp at any device pixel ratio (a canvas is sized in CSS
		// pixels, which looks soft on high-DPI phone screens).
		const pageFlip = new PageFlip(el, {
			width,
			height,
			size: 'stretch',
			minWidth,
			maxWidth: 1400,
			minHeight,
			maxHeight: 1960,
			maxShadowOpacity: 0.5,
			showCover: true,
			mobileScrollSupport: false,
			// Every page is half of a printed spread, so a single-page view on
			// narrow screens would show only half a photo. Always show spreads.
			usePortrait: false,
		});

		pageFlip.loadFromHTML(pageElements);

		const indicator = document.getElementById('page-indicator');
		const updateIndicator = () => {
			if (indicator) {
				indicator.textContent = `${pageFlip.getCurrentPageIndex() + 1} / ${pageFlip.getPageCount()}`;
			}
		};
		updateIndicator();
		pageFlip.on('flip', updateIndicator);

		document.getElementById('prev')?.addEventListener('click', () => pageFlip.flipPrev());
		document.getElementById('next')?.addEventListener('click', () => pageFlip.flipNext());

		window.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') pageFlip.flipPrev();
			if (e.key === 'ArrowRight') pageFlip.flipNext();
		});
	}
</script>

<style>
	.flipbook-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
	}

	#flipbook {
		width: min(90vw, 1100px);
		max-height: 82vh;
	}

	#flipbook .page {
		display: none;
	}

	#flipbook .page img {
		display: block;
		width: 100%;
		height: 100%;
		/* The page box uses a fixed aspect ratio, but individual split
		   pages differ from it by a hair. "contain" would letterbox that
		   gap in at every edge, most visibly as a seam at the spine where
		   two pages meet. "cover" crops the same sliver instead. */
		object-fit: cover;
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		color: var(--muted);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
	}

	.controls button {
		background: none;
		border: 1px solid var(--muted);
		color: var(--fg);
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		font-size: 1.1rem;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.controls button:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	#page-indicator {
		min-width: 4.5rem;
		text-align: center;
	}
</style>
